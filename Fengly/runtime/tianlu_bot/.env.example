# ============================================================
# 机器人配置模板
# 用法：把这个文件复制成 .env，然后填上你自己的信息
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# ============================================================
# ═══════════════════════════════════════════════
#  机器人主配置文件（改完保存，重启机器人生效）
#  每行 = 键 + 值，值不要加引号，# 开头的是注释
# ═══════════════════════════════════════════════

# ─────────── ① AI 对话模型（选一个用）───────────
# 用途：机器人聊天回复用的 AI。必填，否则机器人不会说话。

# ★ 当前使用的模型（填下面其中一个的英文名）：
#   deepseek / zhipu / qwen / kimi / doubao / hunyuan / spark
#   ernie / baichuan / minimax-chat / yi / stepfun
#   openai / groq / mistral / gemini（海外需VPN）
#   ollama / lmstudio（本地，免费）
#   custom（自定义任意 OpenAI 兼容接口）
MODEL_PROVIDER=deepseek

# ── DeepSeek ──  https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 智谱 GLM ──  https://open.bigmodel.cn
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# ── 通义千问 Qwen ──  https://dashscope.console.aliyun.com
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# ── Kimi 月之暗面 ──  https://platform.moonshot.cn
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k

# ── 豆包 Doubao（火山引擎）──  https://console.volcengine.com/ark
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-1-5-pro-32k-250115

# ── 腾讯混元 Hunyuan ──  https://cloud.tencent.com/product/hunyuan
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL=hunyuan-lite

# ── 讯飞星火 Spark ──  https://xinghuo.xfyun.cn
SPARK_API_KEY=
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1
SPARK_MODEL=generalv3.5

# ── 百度文心 ERNIE（千帆）──  https://console.bce.baidu.com/qianfan
ERNIE_API_KEY=
ERNIE_BASE_URL=https://qianfan.baidubce.com/v2
ERNIE_MODEL=ernie-4.0-8k

# ── 百川 Baichuan ──  https://platform.baichuan-ai.com
BAICHUAN_API_KEY=
BAICHUAN_BASE_URL=https://api.baichuan-ai.com/v1
BAICHUAN_MODEL=Baichuan4

# ── MiniMax 对话 ──  https://platform.minimaxi.com
MINIMAX_CHAT_API_KEY=
MINIMAX_CHAT_BASE_URL=https://api.minimax.chat/v1
MINIMAX_CHAT_MODEL=abab6.5s-chat

# ── 零一万物 Yi ──  https://platform.lingyiwanwu.com
YI_API_KEY=
YI_BASE_URL=https://api.lingyiwanwu.com/v1
YI_MODEL=yi-lightning

# ── 阶跃星辰 StepFun ──  https://platform.stepfun.com
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-1-8k

# ── OpenAI GPT（海外）──  https://platform.openai.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Groq（海外）──  https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ── Mistral（海外）──  https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# ── Google Gemini（海外）──  https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

# ── 本地 Ollama ──  先装 https://ollama.com，ollama run qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ── 本地 LM Studio ──  加载模型后开启本地服务器（端口1234）
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=local-model

# ── 自定义（任意 OpenAI 兼容接口）──
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# ─────────── ② 识图（智谱，可选）───────────
# 用途：机器人看图说话 / 识别表情包。不用识图可留空。
# 获取：https://open.bigmodel.cn → API 密钥
# （注：识图独立用智谱的 Key，和上面对话用的 ZHIPU_API_KEY 是同一个）

# ─────────── ③ 语音（MiniMax，可选）───────────
# 用途：机器人用语音回复你。不用语音可留空。
# 获取：https://platform.minimaxi.com → 密钥
MINIMAX_API_KEY=

# 音色 ID：决定机器人说话的声音，登录 MiniMax 语音平台创建音色后填
MINIMAX_VOICE_ID=

# ─────────── ④ 账号（必填）───────────
# 你的 QQ 号（机器人只听你的管理命令）
OWNER_ID=

# 机器人的 QQ 号（你注册给机器人的那个号）
BOT_QQ=

# 机器人工作的群号，多个用英文逗号分隔：123456,654321
GROUP_ID=
# 反馈群：控制台反馈转发到这里，群里@机器人反馈会同步上墙
FEEDBACK_GROUP_ID=

# 屏蔽的 QQ 号：其他 AI/机器人别让它们互相聊起来，逗号分隔，可留空
IGNORE_QQ=

# 是否把收到的图片保存到本地（true/false）
SAVE_IMAGES=false

# ─────────── ⑤ 网易云点歌（可选）───────────
# 用途：点歌下载需要登录状态。用「工具箱 → Cookie 一键导入」最方便，
# 也可以自己粘贴（F12 → 请求头里的 Cookie，需含 MUSIC_U）
NETEASE_COOKIE=

# ─────────── ⑥ 运行环境（不要动）───────────
# dev=开发模式（日志详细）/ prod=生产模式
ENVIRONMENT=dev

# 驱动方式，保持默认即可
DRIVER=~fastapi

# ── 功能开关（true=开启 / false=关闭，改完重启机器人生效）──
# 消息页 / 语音 / 音乐要有内容，必须开启 FEATURE_MONITOR / FEATURE_TTS / FEATURE_SONG
FEATURE_AI_CHAT=true
FEATURE_MONITOR=true
FEATURE_TTS=true
FEATURE_SONG=true
FEATURE_GAMES=true
FEATURE_SIGN=true
FEATURE_LOTTERY=true
FEATURE_FORTUNE=true
FEATURE_IDIOM=true
FEATURE_POKE=true
FEATURE_VISION=true
FEATURE_SYSTEM_COMMANDS=true
FEATURE_FREE_CHAT=false
FEATURE_RANDOM_TALK=false
FEATURE_AUTO_REBOOT=false
