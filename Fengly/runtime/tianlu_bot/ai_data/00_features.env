# ═══════════════════════════════════════════════
#  功能总开关（改完立即生效，不用重启机器人）
#  true=开  false=关。关闭只停用行为，数据（金币/好感度/生日）都会保留
# ═══════════════════════════════════════════════

# ─── 聊天 ───
# AI 对话（总开关，关闭后机器人不再回复聊天）
FEATURE_AI_CHAT=true
# 语音回复（需要 MiniMax Key，未配 Key 时自动不可用）
FEATURE_TTS=true
# 图片识别（需要智谱 Key）
FEATURE_VISION=true

# ─── 游戏 ───
# 游戏系统（商店/买/卖/背包/我的信息）
FEATURE_GAMES=true
# 每日签到
FEATURE_SIGN=true
# 每日抽签
FEATURE_LOTTERY=true
# 运势查询
FEATURE_FORTUNE=true
# 成语接龙
FEATURE_IDIOM=true

# ─── 媒体 ───
# 点歌（依赖 ffmpeg，已内置；高音质需网易云 Cookie）
FEATURE_SONG=true

# ─── 管理 ───
# 系统指令（#sysinfo 等，仅管理员）
FEATURE_SYSTEM_COMMANDS=true
# 匿名消息统计
FEATURE_MONITOR=true
# 每日凌晨自动重启电脑（仅 Windows，默认关）
FEATURE_AUTO_REBOOT=false

# ─── 互动 ───
# 上传音频播放（工具箱上传音频 → 群里「播放音频 名字」）
FEATURE_AUDIO=true

# 戳一戳回复
FEATURE_POKE=true

# ─── 小游戏（FEATURE_GAME_XXX 单开关，FEATURE_GAMES_分类 一类总开关）───
# luck 类总开关
FEATURE_GAMES_LUCK=true
# 和机器人比点数，赢了翻倍
FEATURE_GAME_DICE=true
# 两个骰子比总和
FEATURE_GAME_BATTLE_DICE=true
# 猜正反：掷硬币 正/反
FEATURE_GAME_COIN_FLIP=true
# 骰出 6 点就是大奖
FEATURE_GAME_GUESS_POINT=true
# 三个一样的图标中大奖
FEATURE_GAME_SLOT_MACHINE=true
# 转到什么拿什么
FEATURE_GAME_WHEEL=true
# 随机翻一张奖励牌
FEATURE_GAME_FLIP_CARD=true
# 花钱开宝箱，可能血赚
FEATURE_GAME_TREASURE_BOX=true
# 刮开涂层看运气
FEATURE_GAME_SCRATCH=true
# 抓到大娃娃就是赚
FEATURE_GAME_CLAW_MACHINE=true
# 钓到什么算什么
FEATURE_GAME_FISHING=true
# 一镐子下去看矿脉
FEATURE_GAME_MINING=true
# 砍到什么木头看运气
FEATURE_GAME_CHOP_TREE=true
# 垃圾堆里可能有宝
FEATURE_GAME_TRASH=true
# 盲盒拆开才知道
FEATURE_GAME_BLIND_BOX=true
# 天降红包，免费的哦
FEATURE_GAME_RED_PACKET=true
# 六个格子一颗雷
FEATURE_GAME_MINEFIELD=true
# 高风险高回报
FEATURE_GAME_ROULETTE=true
# 猜硬币在哪只手：猜左右手 左/右
FEATURE_GAME_GUESS_HAND=true
# 三个骰子全一样=大赚
FEATURE_GAME_TRIPLE_SIX=true
# 一次抽十个，必有保底
FEATURE_GAME_TEN_PULL=true
# 抽一张命运之牌
FEATURE_GAME_FATE_CARD=true
# 捡到神秘漂流瓶
FEATURE_GAME_DRIFT_BOTTLE=true
# 天上掉钱啦（免费）
FEATURE_GAME_SKY_COIN=true
# 一锤子下去看打到什么
FEATURE_GAME_WHACK_MOLE=true
# 1~100，大于85中奖
FEATURE_GAME_LUCKY_NUMBER=true
# 猜骰子单双：押单双 单/双
FEATURE_GAME_ODD_EVEN=true
# 猜点数大小：猜大小 大/小
FEATURE_GAME_BIG_SMALL=true
# 一箭射向靶子
FEATURE_GAME_ARCHERY=true
# 拆出什么东西看缘分
FEATURE_GAME_OPEN_PARCEL=true

# 自由聊天模式：开=群里@机器人可以自由聊天；关=群里只响应命令（菜单/语音/点歌）
FEATURE_FREE_CHAT=0
# 随机搭话模式：开=群友没@时机器人按概率随机插话（依赖自由聊天开启）
FEATURE_RANDOM_TALK=0
