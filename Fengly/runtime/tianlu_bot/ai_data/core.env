# ==================== 核心配置 ====================
# 改完重启机器人

# ---------- 历史记录 ----------

# 历史记录保留条数
# user + assistant 各算 1 条，默认 20
MAX_HISTORY=20


# ---------- 冷却 ----------

# 冷却秒数
# 同一用户两次对话的最小间隔，默认 5 秒
COOLDOWN_SECONDS=5


# ---------- 好感度 ----------

# 好感度上限
# 默认 100
MAX_FAVOR=100


# ---------- 运势 ----------

# 运势刷新间隔（秒）
# 默认 86400，即 24 小时
FORTUNE_REFRESH=86400


# ---------- 日志 ----------

# 日志级别
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=DEBUG

# 控制台日志级别
# DEBUG / INFO / WARNING / ERROR
CONSOLE_LOG_LEVEL=INFO

# 单个日志文件最大字节数
# 默认 10MB
LOG_MAX_BYTES=10485760

# 保留日志备份数
# 默认 30
LOG_BACKUP_COUNT=30


# ---------- HTTP 客户端 ----------

# 总超时（秒）
HTTP_TIMEOUT=60.0

# 连接超时（秒）
HTTP_CONNECT_TIMEOUT=3.0

# 最大保持连接数
HTTP_MAX_KEEPALIVE=50

# 最大连接数
HTTP_MAX_CONNECTIONS=100

# 保持连接过期时间（秒）
HTTP_KEEPALIVE_EXPIRY=60.0

# 是否启用 HTTP/2
HTTP2_ENABLED=true