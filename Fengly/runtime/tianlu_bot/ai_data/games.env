# ==================== 游戏配置 ====================
# 改完重启机器人

# ---------- 商店物品 ----------
# 格式：物品名=价格,经验,售价
# 每行一个物品
SHOP_竹子=10,5,8
SHOP_苹果=15,8,12
SHOP_小鱼干=20,10,17
SHOP_烤肉=30,15,25
SHOP_蛋糕=50,25,42
SHOP_仙丹=100,50,85


# ---------- 升级公式 ----------

# 每级需要的经验
# 默认：等级 * 100
# 改成 50 就是：等级 * 50
LEVEL_EXP_MULTIPLIER=100


# ---------- 签到奖励 ----------

# 金币奖励最小值
SIGN_COIN_MIN=10

# 金币奖励最大值
SIGN_COIN_MAX=30

# 经验奖励最小值
SIGN_EXP_MIN=5

# 经验奖励最大值
SIGN_EXP_MAX=20


# ---------- 抽签奖励 ----------

# 经验奖励最小值
LOTTERY_EXP_MIN=5

# 经验奖励最大值
LOTTERY_EXP_MAX=30

# 签文列表
# 逗号分隔
LOTTERY_FORTUNES=大吉,中吉,小吉,末吉


# ---------- 新用户初始数据 ----------

# 初始等级
NEW_USER_LEVEL=1

# 初始经验
NEW_USER_EXP=0

# 初始金币
NEW_USER_COIN=100

# 初始点券
NEW_USER_POINT=0


# ---------- 固定回答 ----------

# 金币不够
GAME_NO_COIN=（撇嘴）金币不够！

# 点券不够
GAME_NO_POINT=（撇嘴）点券不够！

# 没有这个物品
GAME_NO_ITEM=（歪头）没有这种东西！

# 背包空
GAME_EMPTY_BAG=（摊手）背包空空如也！

# 买成功
GAME_BUY_OK=（接过{0}）购买成功！还剩{1}金币～

# 卖成功
GAME_SELL_OK=（卖掉{0}）获得{1}金币！

# 签到成功
GAME_SIGN_OK=签到成功！+{0}金币 +{1}经验

# 已签到
GAME_SIGNED=（甩尾巴）今天已经签到过了！

# 抽签
GAME_LOTTERY=🎋 {0}\n经验+{1}


# ---------- 管理员 ----------

# 修改数据成功
ADMIN_MODIFY_DATA=（点点头）已将 {0} 的 {1} 改为 {2}！

# 改好感度成功
ADMIN_MODIFY_FAVOR=（点点头）已将 {0} 的好感度改为 {1}！

# 字段限制
ADMIN_FIELD_LIMIT=（歪头）字段只能是：level, exp, coin, point