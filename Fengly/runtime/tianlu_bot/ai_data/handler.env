# ==================== 消息处理配置 ====================
# 改完重启机器人

# 私聊白名单
# 逗号分隔，只有这些 QQ 号可以私聊机器人
# 不填就谁都私聊不了
# 例子：PRIVATE_WHITELIST=123456789,987654321
PRIVATE_WHITELIST=

# ---------- 游戏命令黑名单 ----------

# 游戏命令黑名单
# AI 会拦截这些词，不当作普通对话处理
# 逗号分隔
GAME_COMMANDS=商店,买,背包,卖,抽签,我的信息,签到,叫我,我是谁


# ---------- 分句标点 ----------

# 流式回复时，遇到这些标点就发一段
SPLIT_CHARS=。！？!?

# 首段最短长度
# 流式回复时，第一段至少凑够这么多字才发
MIN_SEND_LEN=4