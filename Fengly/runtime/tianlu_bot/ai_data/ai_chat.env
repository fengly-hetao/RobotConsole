# ==================== AI 对话配置 ====================
# 改完重启机器人

# ---------- 点歌 ----------

# 点歌触发词（正则，用 | 分隔）
SING_TRIGGERS=唱|点歌|播放|来一首

# 语音后缀（逗号分隔）
SING_VOICE_SUFFIX=发语音,语音

# DJ 后缀（逗号分隔）
SING_DJ_SUFFIX=DJ版,dj版,DJ,dj

# 歌词前缀（逗号分隔）
SING_LYRICS_PREFIX=歌词：,歌词:

# 点歌超时秒数
SING_TIMEOUT=120


# ---------- 固定回答 ----------

# 空回复兜底
# 当 AI 返回空内容时，用这句话兜底
FALLBACK_EMPTY="（歪头）嗯？你说啥？本座没听清～"

# 超时兜底
# 当 API 请求超时（60 秒没响应）时，用这句话兜底
FALLBACK_TIMEOUT="（甩尾巴）本座卡住了，再试一次！"

# 异常兜底
# 当代码出现其他异常时，用这句话兜底
FALLBACK_ERROR="（挠头）出错了…"

# 语音合成失败
# 当语音合成失败时，用这句话兜底
FALLBACK_VOICE_FAIL="（撇嘴）本座嗓子哑了，说不出来…"

# 没 @ 就发消息
# 群里有人没 @ 机器人就发消息时，用这句话
FALLBACK_NO_AT="（歪头）你@我干嘛？"

# 冷却中
# 同一用户两次对话间隔小于冷却时间时，用这句话
FALLBACK_COOLDOWN="（甩尾巴）急什么！让本座缓5秒！"

# 冷却秒数
# 同一用户两次对话的最小间隔，默认 5 秒
COOLDOWN_SECONDS=0


# ---------- 回复限制 ----------

# 回复最大字数
# 超过会被截断，默认 200
MAX_REPLY_LENGTH=500

# 单次生成上限（token）
# 越大回复越长，越费钱，默认 350
MAX_TOKENS=500

# 随机性（0~2）
# 越大越随机，越小越稳定，默认 0.85
TEMPERATURE=0.85

# 重复惩罚（0~2）
# 越大越不容易重复，默认 0.3
FREQUENCY_PENALTY=0.3

# 新话题惩罚（0~2）
# 越大越不容易跑题，默认 0.3
PRESENCE_PENALTY=0.3

# 分句标点
# 流式回复时，遇到这些标点就发一段
SPLIT_CHARS=。！？!?

# 首段最短长度
# 流式回复时，第一段至少凑够这么多字才发
MIN_SEND_LEN=4

# 历史记录保留条数
# user + assistant 各算 1 条，默认 20
MAX_HISTORY=20


# ---------- 随心说 ----------

# 语音概率（0~1）
# 0.3 表示 30% 概率用语音回复，70% 概率文字
VOICE_RANDOM_PROB=0.3


# ---------- 语音合成 ----------

# 语音模型
# speech-2.8-hd    ：音质最高，3.5 元/万字符
# speech-2.8-turbo ：音质略降，2 元/万字符，推荐
TTS_MODEL=speech-2.8-turbo

# 语速（0.5~2.0）
# 1.0 是正常语速
TTS_SPEED=1.0

# 采样率
# 32000 是 MiniMax 推荐值
TTS_SAMPLE_RATE=32000

# 语音缓存条数
# 超过会清掉最早的一半，默认 200
TTS_CACHE_MAX=200


# ---------- 动作词库 ----------

# 动作词库
# 逗号分隔，AI 说话时会从这里挑一个放在括号里
# 想改动作就改这里
ACTIONS=甩尾巴,翻白眼,打哈欠,竖起耳朵,歪头,嚼着零食,用爪子戳屏幕,抖毛,伸懒腰,抱胸,撇嘴,叹气


# ---------- 快捷指令触发词 ----------

# 摸头
# 消息里包含这两个字时，好感度 +3
TRIGGER_TOUCH=摸头

# 运势
# 消息里包含这两个字时，返回今日运势
TRIGGER_FORTUNE=运势

# 接龙
# 消息里包含这两个字时，触发成语接龙
TRIGGER_IDIOM=接龙

# 角色查询
# 消息里包含这两个词之一时，触发角色查询
TRIGGER_CHARACTER_1=是谁
TRIGGER_CHARACTER_2=什么角色

# 语音直读
# 消息以「说 」开头时，必定用语音回复
TRIGGER_VOICE="说 "
# ---------- 每日限额（防刷爆，0 = 不限） ----------

# 每用户每天 AI 对话次数上限
DAILY_AI_LIMIT=200

# 每用户每天语音合成次数上限
DAILY_TTS_LIMIT=30

# 每用户每天点歌次数上限
DAILY_SONG_LIMIT=20

# 单次语音合成最大字数（超出截断，防长文烧钱）
TTS_MAX_CHARS=200

# 随机搭话概率（0~1，0.03=约3%）
RANDOM_TALK_PROB=0.03
# 随机搭话群冷却（秒，防刷屏）
RANDOM_TALK_COOLDOWN=120

# 真人说话模式（true=按句发，最多5条；false=合并成3~6条，每条40~60字）
FEATURE_HUMAN_MODE=true

# 歌词接龙（true=群友@我发歌词，我会接下一句）
FEATURE_LYRIC_ECHO=true

# 歌词库-收藏歌单（逗号分隔的网易云歌单ID）
LYRIC_FAV_PLAYLISTS=18002702823,18170739202
